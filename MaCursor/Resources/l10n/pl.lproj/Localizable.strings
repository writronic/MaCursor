"Add to Favorites" = "Dodaj do ulubionych";

/* Context menu: unmark the favorite theme */
"Remove from Favorites" = "Usuń z ulubionych";

/* Menu bar panel: placeholder when no theme is a favorite */
"No favorite themes yet" = "Brak ulubionych schematów";

/* Menu bar panel: caption under the favorites placeholder */
"Mark themes as favorites in MaCursor to show them here." = "Oznacz schematy jako ulubione w MaCursor, aby wyświetlić je tutaj.";

/* Helper status: installed but not running */
"Installed, not running" = "Zainstalowany, ale nie uruchomiony";

/* Menu bar right-click menu: quits the app */
"Quit MaCursor" = "Zakończ MaCursor";

/* Heading of the window that opens when focus follows mouse is turned on without Accessibility access */
"Allow Accessibility Access" = "Zezwól na dostęp do funkcji Dostępność";

/* Explanation in that window; "MaCursorHelper" is the product name of the login-item helper and stays untranslated; "Allow for Accessibility" is the button below it */
"MaCursorHelper needs Accessibility access to bring the window under the mouse pointer to the front. Choose Allow for Accessibility, then turn on MaCursorHelper in Privacy & Security → Accessibility." = "MaCursorHelper wymaga dostępu do funkcji Dostępność, aby przenieść na wierzch okno znajdujące się pod wskaźnikiem myszy. Wybierz „Zezwól na dostępność”, a następnie włącz MaCursorHelper w sekcji Prywatność i ochrona → Dostępność.";

/* Primary button of that window; asks the helper to show the macOS permission dialog */
"Allow for Accessibility" = "Zezwól na dostępność";

/* Secondary button of that window; closes it and leaves focus follows mouse on */
"Not Now" = "Nie teraz";

/* Status shown in that window after the button was pressed */
"Waiting for access. This window updates as soon as MaCursorHelper is allowed." = "Oczekiwanie na dostęp. To okno zaktualizuje się, gdy tylko MaCursorHelper uzyska zezwolenie.";

/* Status shown in that window once Accessibility access was granted */
"Access granted" = "Dostęp przyznany";

/* Button that closes that window once access was granted */
"Let’s Go!" = "Zaczynamy!";

/* Empty search result in the Edit Theme sidebar; %@ is the search text */
"No Results for “%@”" = "Brak wyników dla „%@”";
