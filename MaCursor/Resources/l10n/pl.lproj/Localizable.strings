"MaCursor needs Screen Recording access to read the text inside the frame. Nothing is saved, and the text goes only to the Translation Service you choose. Choose Allow Screen Recording, then turn on MaCursor in Privacy & Security → Screen Recording." = "MaCursor wymaga dostępu do nagrywania ekranu, aby czytać tekst w ramce. Nic nie jest zapisywane, a tekst trafia tylko do wybranej usługi tłumaczenia. Wybierz „Zezwól na nagrywanie ekranu”, a następnie włącz MaCursor w sekcji Prywatność i ochrona → Nagrywanie ekranu.";

/* Cursor Translator frame: no text was found, and this macOS version cannot read some languages (for example Arabic on macOS 14). %@ is a list of language names, such as “Arabic and Hindi”. */
"No text found. This macOS version cannot read %@." = "Nie znaleziono tekstu. Ta wersja macOS nie potrafi odczytać języków: %@.";

/* Cursor Translator frame: the name tag while macOS prepares its text reader, which can take a few minutes the first time or after macOS frees disk space */
"Preparing…" = "Przygotowywanie…";

/* Cursor Translator: the page language, in Settings and on the frame's name tag. “Translate from” is the setting next to “Translate to”; “Detect Language” is its first choice and lets MaCursor find the page language; “Auto: %@” shows the language it found, for example “Auto: German” */
"Translate from" = "Tłumacz z";
"Detect Language" = "Wykryj język";
"Auto: %@" = "Automatycznie: %@";

/* Cursor Translator: the first choice of “Translate to” in Settings. It follows the Mac's language; %@ is that language's name, for example “English (System Default)” */
"%@ (System Default)" = "%@ (Domyślny systemowy)";
