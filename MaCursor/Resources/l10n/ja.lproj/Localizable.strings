/* Caption under the Panel Background slider */
"Sets how see-through the menu bar panel is: the middle of the slider is the standard frosted glass, the minimum is clear, the maximum is solid." = "メニューバーパネルの透明度を設定します。スライダーの中央が標準のすりガラス、最小が透明、最大が不透明になります。";

/* Favorites */

/* Context menu: mark the theme as a favorite */
"Add to Favorites" = "お気に入りに追加";

/* Context menu: unmark the favorite theme */
"Remove from Favorites" = "お気に入りから削除";

/* Menu bar panel: placeholder when no theme is a favorite */
"No favorite themes yet" = "お気に入りのテーマはまだありません";

/* Menu bar panel: caption under the favorites placeholder */
"Mark themes as favorites in MaCursor to show them here." = "MaCursorでテーマをお気に入りに登録すると、ここに表示されます。";

/* Helper status: installed but not running */
"Installed, not running" = "インストール済み・停止中";

/* Menu bar right-click menu: quits the app */
"Quit MaCursor" = "MaCursorを終了";

/* Heading of the window that opens when focus follows mouse is turned on without Accessibility access */
"Allow Accessibility Access" = "アクセシビリティへのアクセスを許可";

/* Explanation in that window; "MaCursorHelper" is the product name of the login-item helper and stays untranslated; "Allow for Accessibility" is the button below it */
"MaCursorHelper needs Accessibility access to bring the window under the mouse pointer to the front. Choose Allow for Accessibility, then turn on MaCursorHelper in Privacy & Security → Accessibility." = "MaCursorHelperは、マウスポインタの下にあるウインドウを最前面に移動するためにアクセシビリティへのアクセス権を必要とします。「アクセシビリティを許可」を選択し、「プライバシーとセキュリティ」→「アクセシビリティ」でMaCursorHelperを許可してください。";

/* Primary button of that window; asks the helper to show the macOS permission dialog */
"Allow for Accessibility" = "アクセシビリティを許可";

/* Secondary button of that window; closes it and leaves focus follows mouse on */
"Not Now" = "今はしない";

/* Status shown in that window after the button was pressed */
"Waiting for access. This window updates as soon as MaCursorHelper is allowed." = "アクセスを待機中です。MaCursorHelperが許可されると、このウインドウはすぐに更新されます。";

/* Status shown in that window once Accessibility access was granted */
"Access granted" = "アクセスが許可されました";

/* Button that closes that window once access was granted */
"Let’s Go!" = "さあ、始めましょう！";

/* Empty search result in the Edit Theme sidebar; %@ is the search text */
"No Results for “%@”" = "「%@」の検索結果なし";
