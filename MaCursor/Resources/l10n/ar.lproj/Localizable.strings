/* Caption under the Show Menu Bar Icon toggle while the Helper Tool is not installed */
"The menu bar icon is provided by the Helper Tool. Install it above to use it." = "يتم توفير رمز شريط القوائم بواسطة الأداة المساعدة. قم بتثبيتها أعلاه لاستخدامها.";

/* Caption under the Show Menu Bar Icon toggle */
"Shows a MaCursor icon in the menu bar for switching cursor themes and per-app rules. If it does not appear, open System Settings and look in the Menu Bar section." = "يُظهر رمز MaCursor في شريط القوائم لتبديل سمات المؤشر وقواعد كل تطبيق. إذا لم يظهر، فافتح «إعدادات النظام» وابحث في قسم «شريط القوائم».";

/* Menu bar panel */

/* Menu bar panel: theme name shown when no theme is applied */
"System cursors" = "مؤشرات النظام";

/* Menu bar panel: placeholder when the library is empty */
"No cursor themes yet" = "لا توجد سمات مؤشر بعد";

/* Menu bar panel: heading above the frontmost app */
"Active App" = "التطبيق النشط";

/* Menu bar panel: label of the per-app theme picker */
"Cursor for this app" = "مؤشر هذا التطبيق";

/* Menu bar panel: the theme the frontmost app's rule applies; %@ is the theme name */
"Uses %@" = "يستخدم %@";

/* Menu bar panel: the frontmost app has no rule and follows the applied theme */
"Uses the current cursor" = "يستخدم المؤشر الحالي";

/* Menu bar panel: placeholder when no app is frontmost */
"No app in front" = "لا يوجد تطبيق في المقدمة";

/* Menu bar panel: heading above the scale slider and the toggles */
"Quick Controls" = "عناصر التحكم السريعة";

/* Menu bar panel: status under the Focus on Hover toggle while the permission is missing */
"Needs Accessibility access" = "يحتاج إلى الوصول إلى تسهيلات الاستخدام";

/* Slider label: translucency of the menu bar panel */
"Panel Background" = "خلفية اللوحة";

/* Caption under the Panel Background slider */
"Sets how see-through the menu bar panel is: the middle of the slider is the standard frosted glass, the minimum is clear, the maximum is solid." = "يحدد درجة شفافية لوحة شريط القوائم: يمثل منتصف شريط التمرير الزجاج المصنفر القياسي، والحد الأدنى شفاف تمامًا، والحد الأقصى غير شفاف.";

/* Favorites */

/* Context menu: mark the theme as a favorite */
"Add to Favorites" = "إضافة إلى المفضلة";

/* Context menu: unmark the favorite theme */
"Remove from Favorites" = "إزالة من المفضلة";

/* Menu bar panel: placeholder when no theme is a favorite */
"No favorite themes yet" = "لا توجد سمات مفضلة بعد";

/* Menu bar panel: caption under the favorites placeholder */
"Mark themes as favorites in MaCursor to show them here." = "ضع علامة على السمات كمفضلة في MaCursor لعرضها هنا.";

/* Helper status: installed but not running */
"Installed, not running" = "مُثبَّتة، غير قيد التشغيل";

/* Menu bar right-click menu: quits the app */
"Quit MaCursor" = "إنهاء MaCursor";

/* Heading of the window that opens when focus follows mouse is turned on without Accessibility access */
"Allow Accessibility Access" = "السماح بالوصول إلى تسهيلات الاستخدام";

/* Explanation in that window; "MaCursorHelper" is the product name of the login-item helper and stays untranslated; "Allow for Accessibility" is the button below it */
"MaCursorHelper needs Accessibility access to bring the window under the mouse pointer to the front. Choose Allow for Accessibility, then turn on MaCursorHelper in Privacy & Security → Accessibility." = "يحتاج MaCursorHelper إلى «تسهيلات الاستخدام» لإحضار النافذة الموجودة تحت مؤشر الماوس إلى المقدمة. اختر «السماح بتسهيلات الاستخدام»، ثم اسمح لـ MaCursorHelper في «الخصوصية والأمن» ← «تسهيلات الاستخدام».";

/* Primary button of that window; asks the helper to show the macOS permission dialog */
"Allow for Accessibility" = "السماح بتسهيلات الاستخدام";

/* Secondary button of that window; closes it and leaves focus follows mouse on */
"Not Now" = "ليس الآن";

/* Status shown in that window after the button was pressed */
"Waiting for access. This window updates as soon as MaCursorHelper is allowed." = "في انتظار الإذن. سيتم تحديث هذه النافذة فور السماح لـ MaCursorHelper.";

/* Status shown in that window once Accessibility access was granted */
"Access granted" = "تم منح الإذن";

/* Button that closes that window once access was granted */
"Let’s Go!" = "هيا بنا!";

/* Empty search result in the Edit Theme sidebar; %@ is the search text */
"No Results for “%@”" = "لا توجد نتائج لـ «%@»";
