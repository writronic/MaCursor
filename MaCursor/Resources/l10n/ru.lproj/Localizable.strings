/* Menu bar panel: heading above the frontmost app */
"Active App" = "Активное приложение";

/* Menu bar panel: label of the per-app theme picker */
"Cursor for this app" = "Курсор для этого приложения";

/* Menu bar panel: the theme the frontmost app's rule applies; %@ is the theme name */
"Uses %@" = "Использует %@";

/* Menu bar panel: the frontmost app has no rule and follows the applied theme */
"Uses the current cursor" = "Использует текущий курсор";

/* Menu bar panel: placeholder when no app is frontmost */
"No app in front" = "На переднем плане нет приложения";

/* Menu bar panel: heading above the scale slider and the toggles */
"Quick Controls" = "Быстрые элементы управления";

/* Menu bar panel: status under the Focus on Hover toggle while the permission is missing */
"Needs Accessibility access" = "Требуется Универсальный доступ";

/* Slider label: translucency of the menu bar panel */
"Panel Background" = "Фон панели";

/* Caption under the Panel Background slider */
"Sets how see-through the menu bar panel is: the middle of the slider is the standard frosted glass, the minimum is clear, the maximum is solid." = "Задаёт степень прозрачности панели в строке меню: среднее положение ползунка — стандартное матовое стекло, минимальное — полная прозрачность, максимальное — непрозрачность.";

/* Favorites */

/* Context menu: mark the theme as a favorite */
"Add to Favorites" = "Добавить в избранное";

/* Context menu: unmark the favorite theme */
"Remove from Favorites" = "Удалить из избранного";

/* Menu bar panel: placeholder when no theme is a favorite */
"No favorite themes yet" = "Избранных тем пока нет";

/* Menu bar panel: caption under the favorites placeholder */
"Mark themes as favorites in MaCursor to show them here." = "Отметьте темы как избранные в MaCursor, чтобы они отображались здесь.";

/* Helper status: installed but not running */
"Installed, not running" = "Установлен, не запущен";

/* Menu bar right-click menu: quits the app */
"Quit MaCursor" = "Завершить MaCursor";

/* Heading of the window that opens when focus follows mouse is turned on without Accessibility access */
"Allow Accessibility Access" = "Предоставьте Универсальный доступ";

/* Explanation in that window; "MaCursorHelper" is the product name of the login-item helper and stays untranslated; "Allow for Accessibility" is the button below it */
"MaCursorHelper needs Accessibility access to bring the window under the mouse pointer to the front. Choose Allow for Accessibility, then turn on MaCursorHelper in Privacy & Security → Accessibility." = "Программе MaCursorHelper нужен «Универсальный доступ», чтобы выводить на передний план окно под указателем мыши. Выберите «Разрешить Универсальный доступ», затем включите MaCursorHelper в разделе «Конфиденциальность и безопасность» → «Универсальный доступ».";

/* Primary button of that window; asks the helper to show the macOS permission dialog */
"Allow for Accessibility" = "Разрешить Универсальный доступ";

/* Secondary button of that window; closes it and leaves focus follows mouse on */
"Not Now" = "Не сейчас";

/* Status shown in that window after the button was pressed */
"Waiting for access. This window updates as soon as MaCursorHelper is allowed." = "Ожидание доступа. Это окно обновится, как только MaCursorHelper получит разрешение.";

/* Status shown in that window once Accessibility access was granted */
"Access granted" = "Доступ предоставлен";

/* Button that closes that window once access was granted */
"Let’s Go!" = "Приступим!";

/* Empty search result in the Edit Theme sidebar; %@ is the search text */
"No Results for “%@”" = "Нет результатов по запросу «%@»";
