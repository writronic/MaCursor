/* Context menu: unmark the favorite theme */
"Remove from Favorites" = "Favorilerden Kaldır";

/* Menu bar panel: placeholder when no theme is a favorite */
"No favorite themes yet" = "Henüz favori tema yok";

/* Menu bar panel: caption under the favorites placeholder */
"Mark themes as favorites in MaCursor to show them here." = "Temaları burada göstermek için MaCursor’da favori olarak işaretleyin.";

/* Helper status: installed but not running */
"Installed, not running" = "Yüklü, çalışmıyor";

/* Menu bar right-click menu: quits the app */
"Quit MaCursor" = "MaCursor'dan Çık";

/* Empty search result in the Edit Theme sidebar; %@ is the search text */
"No Results for “%@”" = "“%@” için sonuç yok";

/* Heading of the window that opens when focus follows mouse is turned on without Accessibility access */
"Allow Accessibility Access" = "Erişilebilirlik İznini Ver";

/* Explanation in that window; "MaCursorHelper" is the product name of the login-item helper and stays untranslated; "Allow for Accessibility" is the button below it */
"MaCursorHelper needs Accessibility access to bring the window under the mouse pointer to the front. Choose Allow for Accessibility, then turn on MaCursorHelper in Privacy & Security → Accessibility." = "MaCursorHelper, fare imlecinin altındaki pencereyi ön plana getirmek için Erişilebilirlik iznine ihtiyaç duyar. “Erişilebilirlik İçin İzin Ver” düğmesini seçin, ardından Gizlilik ve Güvenlik → Erişilebilirlik bölümünde MaCursorHelper’a izin verin.";

/* Primary button of that window; asks the helper to show the macOS permission dialog */
"Allow for Accessibility" = "Erişilebilirlik İçin İzin Ver";

/* Secondary button of that window; closes it and leaves focus follows mouse on */
"Not Now" = "Şimdi Değil";

/* Status shown in that window after the button was pressed */
"Waiting for access. This window updates as soon as MaCursorHelper is allowed." = "Erişim izni bekleniyor. MaCursorHelper’a izin verilir verilmez bu pencere güncellenir.";

/* Status shown in that window once Accessibility access was granted */
"Access granted" = "Erişim izni verildi";

/* Button that closes that window once access was granted */
"Let’s Go!" = "Hadi Başlayalım!";
