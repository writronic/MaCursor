"A star on GitHub also helps more people find MaCursor, and it means a lot." = "GitHub’da bir yıldız, MaCursor’u daha fazla kişinin bulmasına da yardımcı olur ve bizim için çok değerlidir.";
"Give a Star" = "Yıldız Ver";
/* Welcome window: button at the end of an access line whose dot is red; it opens System Settings at that access */
"Grant Permission" = "İzin Ver";
/* Welcome window: what VoiceOver reads after the name of an access whose dot is red */
"Access not granted" = "Erişim izni verilmedi";

/* Welcome window: line under the cards on pages 2 to 4 while the Helper Tool is installed but not running. MaCursor starts it again when it opens. */
"The Helper Tool is not running. Quit and reopen MaCursor to start it." = "Yardımcı Araç çalışmıyor. Başlatmak için MaCursor’dan çıkıp yeniden açın.";

"Hide desktop icons while capturing" = "Yakalarken masaüstü simgelerini gizle";

"Left Button" = "Sol Düğme";
"Hold a key with the left or right button, so normal clicks still work." = "Sol veya sağ düğmeyle birlikte bir tuşu basılı tutun; böylece normal tıklamalar çalışmaya devam eder.";
"A Cursor Capture shortcut uses the same keys and button. Cursor Capture takes it." = "Bir İmleç Yakalama kısayolu aynı tuşları ve düğmeyi kullanıyor. Öncelik İmleç Yakalama’da.";

/* Trail style: copies of the cursor picture left at the pointer's recent places, like Windows pointer trails */
"Echoes" = "Yankılar";

/* Cursor Gestures: short lines under the actions that run a Cursor Capture command from the menu bar panel. The last line is shared by the actions that switch Cursor Shadow, Focus on Hover, Cursor Translator, Cursor Shaker, Cursor Trails and Per-App Themes */
"Take a picture of the same area again" = "Aynı alanın resmini yeniden çeker";
"Take a picture of the screen under the pointer" = "İmlecin bulunduğu ekranın resmini çeker";
"Choose a part, and the picture is taken after a wait" = "Bir bölüm seçersiniz, resim kısa bir beklemeden sonra çekilir";
"Copy the text in the part you choose" = "Seçtiğiniz bölümdeki metni kopyalar";
"Open a picture file in the editor" = "Bir resim dosyasını düzenleyicide açar";
"Open the picture on the clipboard in the editor" = "Panodaki resmi düzenleyicide açar";
"Keep a picture on top of your windows" = "Bir resmi pencerelerinizin üstünde tutar";
"See the pictures you took before" = "Daha önce çektiğiniz resimleri gösterir";
"Turn it on, or off when it is on" = "Kapalıysa açar, açıksa kapatır";

/* Cursor Trails, Echoes style: the two choices of the Colors drop-down. "Use Colors on Glow" puts the chosen colours on the glow only; "Use Colors with Style" also fills the copies of the cursor with them */
"Use Colors on Glow" = "Renkleri Parıltıda Kullan";
"Use Colors with Style" = "Renkleri Stil ile Kullan";
