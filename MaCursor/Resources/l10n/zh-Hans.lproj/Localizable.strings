"MaCursorHelper needs Accessibility access to bring the window under the mouse pointer to the front. Choose Allow for Accessibility, then turn on MaCursorHelper in Privacy & Security → Accessibility." = "MaCursorHelper 需要辅助功能权限，才能将鼠标指针下方的窗口置于最前面。请选择“允许辅助功能”，然后在“隐私与安全性”→“辅助功能”中允许 MaCursorHelper。";

/* Primary button of that window; asks the helper to show the macOS permission dialog */
"Allow for Accessibility" = "允许辅助功能";

/* Secondary button of that window; closes it and leaves focus follows mouse on */
"Not Now" = "以后再说";

/* Status shown in that window after the button was pressed */
"Waiting for access. This window updates as soon as MaCursorHelper is allowed." = "正在等待权限。一旦允许 MaCursorHelper，此窗口会立即更新。";

/* Status shown in that window once Accessibility access was granted */
"Access granted" = "已获得权限";

/* Button that closes that window once access was granted */
"Let’s Go!" = "开始吧！";

/* Empty search result in the Edit Theme sidebar; %@ is the search text */
"No Results for “%@”" = "未找到“%@”的相关结果";
